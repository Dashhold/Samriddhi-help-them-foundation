{
  "name": "samriddhi-help-team-foundation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "check": "npm run check --workspace frontend && npm run check --workspace backend",
    "test": "npm run test --workspace backend",
    "format": "npm run format --workspace frontend",
    "format:check": "npm run format:check --workspace frontend",
    "migrate": "npm run migrate --workspace backend",
    "start": "npm run start --workspace backend"
  }
}
