# Backend Railway service. Set real values in Railway variables, never in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_SSL=disable
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional: comma-separated frontend URLs allowed to call the API. Empty allows any origin.
FRONTEND_ORIGINS=https://your-frontend.up.railway.app
# Optional on Railway: defaults to https://$RAILWAY_PUBLIC_DOMAIN.
PUBLIC_API_URL=https://your-backend.up.railway.app
SESSION_TTL_HOURS=8
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
