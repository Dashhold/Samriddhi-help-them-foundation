# Backend Railway service. Only a database connection is required; everything else has a default.
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional. Defaults: admin username "jagbir-samriddhi" with the built-in default password.
# Setting ADMIN_PASSWORD (12+ characters) replaces the default password on the next start.
# ADMIN_USERNAME=jagbir-samriddhi
# ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional. Comma-separated frontend URLs allowed to call the API. Empty allows any origin.
# FRONTEND_ORIGINS=https://your-frontend.up.railway.app

# Optional. Defaults to https://$RAILWAY_PUBLIC_DOMAIN on Railway.
# PUBLIC_API_URL=https://your-backend.up.railway.app

# Optional. Set to "require" only for a database URL that needs TLS.
# DATABASE_SSL=disable
